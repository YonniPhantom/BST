{
  "name": "mi-app-launcher",
  "version": "1.0.0",
  "description": "Biblioteca Software Tec - Aplicación de escritorio",
  "author": "YonniPhantom",
  "main": "launcher.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "wait-on": "^7.2.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.yonniphantom.bst",
    "productName": "BST",
    "directories": {
      "output": "dist"
    },
    "files": [
      "launcher.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!data/**/*",
          "!data"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend"
      },
      {
        "from": "Manuales",
        "to": "launcher/Manuales"
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "../frontend/public/icon.png"
    },
    "mac": {
      "icon": "../frontend/public/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "icon": "../frontend/public/icon.png",
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}