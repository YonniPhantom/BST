{
  "name": "bst2web",
  "productName": "BST",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "YonniPhantom",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"sleep 3 && npm run electron:build && electron .\"",
    "electron:build": "tsc electron/main.ts electron/preload.ts --outDir dist/electron --target ES2020 --module commonjs --esModuleInterop --allowSyntheticDefaultImports --skipLibCheck && mv dist/electron/main.js dist/electron/main.cjs && mv dist/electron/preload.js dist/electron/preload.js",
    "electron:prod": "npm run build && npm run electron:build && electron .",
    "package": "npm run build && npm run electron:build && electron-builder"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "lucide-react": "^0.545.0",
    "motion": "^12.23.22",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.4",
    "sweetalert2": "^11.25.1",
    "tailwindcss": "^4.1.14",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^8.2.2",
    "electron": "^38.2.2",
    "electron-builder": "^25.1.8",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "nodemon": "^3.1.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.yonniphantom.bst",
    "productName": "BST",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "public/icon.png",
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "public/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "public/icon.png",
      "category": "Education",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
